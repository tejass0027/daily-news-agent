# Copy this file to .env for local testing.
# In production (GitHub Actions) these are set as repo Secrets instead - see README.md.

# --- Branding ---
HANDLE=@__thedailybrief__

# --- Instagram (Meta Graph API) ---
# IG_BUSINESS_ID = your Instagram Business Account's numeric ID
# IG_ACCESS_TOKEN = long-lived Page access token with instagram_content_publish permission
IG_BUSINESS_ID=
IG_ACCESS_TOKEN=

# --- Twitter / X API v2 (free tier) ---
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# --- Public image hosting (used so Instagram's servers can fetch the PNGs) ---
# Set automatically in GitHub Actions from GITHUB_REPOSITORY. For local testing,
# leave blank - Instagram posting will be skipped since there's no public URL yet.
PUBLIC_IMAGE_BASE_URL=
